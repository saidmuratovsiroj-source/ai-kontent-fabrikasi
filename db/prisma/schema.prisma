datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AgentRole {
  PLANNER
  WRITER
  EDITOR
  RESEARCHER
  CRITIC
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum KanbanStatus {
  NAVBATDA
  ISHDA
  JAVOB_KUTILMOQDA
  TEKSHIRUVDA
  TASDIQLANGAN
  BEKOR_QILINDI
}

enum Platform {
  YOUTUBE
  TELEGRAM
  INSTAGRAM
}

enum Who {
  MEN
  RAQIB
}

enum ContentPlanStatus {
  REJALASHTIRILGAN
  TAYYORLANOQDA
  NASHR_QILINDI
  BEKOR_QILINDI
}

enum KnowledgeType {
  HUJJAT
  RASM
  STIL_REFERENS
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum IdeaPriority {
  YUQORI
  ORTA
  PAST
}

enum IdeaStatus {
  YANGI
  REJALASHTIRILDI
  AMALGA_OSHIRILDI
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  emoji       String   @default("📁")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  runs         Run[]
  channels     Channel[]
  knowledgeItems KnowledgeItem[]
  ideas        Idea[]
  videoFolders VideoFolder[]

  @@map("projects")
}

model Idea {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  platform    Platform     @default(YOUTUBE)
  priority    IdeaPriority @default(ORTA)
  status      IdeaStatus   @default(YANGI)
  projectId   String?      @map("project_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("ideas")
}

model VideoFolder {
  id        String   @id @default(uuid())
  title     String
  topic     String
  script    String?  @db.Text
  report    String?  @db.Text
  thumbnail String?  @db.Text
  plan      String?  @db.Text
  projectId String?  @map("project_id")
  runId     String?  @unique @map("run_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@map("video_folders")
}

model Agent {
  id           String    @id @default(uuid())
  name         String
  role         AgentRole
  systemPrompt String    @map("system_prompt") @db.Text
  model        String    @default("claude-sonnet-4-6")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tasks        Task[]
  messages     ChatMessage[]

  @@map("agents")
}

model Run {
  id           String    @id @default(uuid())
  title        String
  status       RunStatus @default(PENDING)
  input        String    @db.Text
  output       String?   @db.Text
  budgetLimit  Float?    @map("budget_limit")
  budgetSpent  Float     @default(0) @map("budget_spent")
  projectId    String?   @map("project_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tasks        Task[]
  messages     ChatMessage[]
  contentPlans ContentPlan[]
  videoFolder  VideoFolder?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("runs")
}

model Task {
  id          String     @id @default(uuid())
  runId       String     @map("run_id")
  agentId     String     @map("agent_id")
  title       String
  description String     @db.Text
  status        TaskStatus   @default(PENDING)
  kanbanStatus  KanbanStatus @default(NAVBATDA) @map("kanban_status")
  result        String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  run           Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent         Agent        @relation(fields: [agentId], references: [id])

  @@map("tasks")
}

model ChatMessage {
  id        String      @id @default(uuid())
  runId     String      @map("run_id")
  agentId   String?     @map("agent_id")
  role      MessageRole
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  run       Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent     Agent?      @relation(fields: [agentId], references: [id])

  @@map("chat_messages")
}

model KnowledgeItem {
  id        String        @id @default(uuid())
  type      KnowledgeType @default(HUJJAT)
  title     String
  source    String
  content   String        @db.Text
  summary   String?       @db.Text
  visibleTo String[]      @default([]) @map("visible_to")
  chunks    Int           @default(0)
  sizeKb    Float         @map("size_kb")
  projectId String?       @map("project_id")
  createdAt DateTime      @default(now()) @map("created_at")

  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("knowledge_items")
}

model UsageLog {
  id           String   @id @default(uuid())
  operation    String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  costCents    Float    @map("cost_cents")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("usage_logs")
}

model Channel {
  id          String    @id @default(uuid())
  platform    Platform
  channelUrl  String    @map("channel_url")
  channelName String    @map("channel_name")
  who         Who
  subscribers Int       @default(0)
  views       Float     @default(0)
  videosCount Int       @default(0) @map("videos_count")
  lastSync    DateTime? @map("last_sync")
  projectId   String?   @map("project_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  maqsad      Maqsad[]
  snapshots   ChannelSnapshot[]
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("channels")
}

model ChannelSnapshot {
  id          String   @id @default(uuid())
  channelId   String   @map("channel_id")
  subscribers Int
  views       Float
  videosCount Int      @map("videos_count")
  createdAt   DateTime @default(now()) @map("created_at")

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_snapshots")
}

model Maqsad {
  id                String   @id @default(uuid())
  targetSubscribers Int      @map("target_subscribers")
  targetDate        DateTime @map("target_date")
  mainChannelId     String?  @map("main_channel_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  mainChannel       Channel? @relation(fields: [mainChannelId], references: [id], onDelete: SetNull)

  @@map("maqsad")
}

model ContentPlan {
  id          String            @id @default(uuid())
  title       String
  platform    Platform
  plannedDate DateTime          @map("planned_date")
  status      ContentPlanStatus @default(REJALASHTIRILGAN)
  runId       String?           @map("run_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  run         Run?              @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@map("content_plans")
}
